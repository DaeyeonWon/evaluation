# AIPO operations console — environment variables.
# Copy to .env.local for `next dev`; set them on the Cloud Run service in production.
# All are optional unless noted. Read at server RUNTIME unless marked [build].
# Details: docs/auth.md (auth / roles / Hermes) and docs/adoption.md (adoption guide, Korean).

# ── Auth ───────────────────────────────────────────────────────────────────────
# mock | iap | oidc-header  (default: mock)
#   mock        demo /login page, signed HttpOnly cookie (local dev / public demo only)
#   iap         Google Cloud IAP headers (x-goog-authenticated-user-email [+ JWT])
#   oidc-header trusted email header set by an authenticating reverse proxy
CONSOLE_AUTH_MODE=mock

# mock mode: HMAC key for the session cookie. REQUIRED anywhere but a laptop (≥ 16 chars, use 32+ random bytes).
#   openssl rand -hex 32
# Unset → insecure built-in dev secret + a warning in the server log.
CONSOLE_SESSION_SECRET=

# iap mode: expected `aud` of the IAP JWT (x-goog-iap-jwt-assertion). STRONGLY recommended.
#   Load balancer + backend service: /projects/PROJECT_NUMBER/global/backendServices/SERVICE_ID
#   Cloud Run IAP (direct):          /projects/PROJECT_NUMBER/locations/REGION/services/SERVICE_NAME
# Unset → the email header is trusted without verification (only safe if IAP is the only ingress).
IAP_AUDIENCE=

# oidc-header mode: header names set by the auth proxy (defaults shown)
CONSOLE_AUTH_EMAIL_HEADER=x-forwarded-email
CONSOLE_AUTH_NAME_HEADER=x-forwarded-user

# ── Role assignment (comma-separated emails; added on top of console.config.ts rules) ──
CONSOLE_ADMINS=
CONSOLE_OPERATORS=
CONSOLE_VIEWERS=
# view + hermes:access only
CONSOLE_HERMES_USERS=
# every user in these email domains gets Viewer (comma-separated, e.g. example.com)
CONSOLE_VIEWER_DOMAINS=

# ── External links ─────────────────────────────────────────────────────────────
# Hermes dashboard URL. /hermes redirects here (307) for users with hermes:access.
# Unset → /hermes shows a "not configured yet" placeholder.
HERMES_DASHBOARD_URL=

# ── Branding ───────────────────────────────────────────────────────────────────
# environment badge on /login and 403 (default: DEV, or PROD when NODE_ENV=production)
CONSOLE_ENV_LABEL=

# ── Data API ───────────────────────────────────────────────────────────────────
# [build] Real Operations API base (FastAPI implementing the /api/v1 contract), e.g.
#   https://ops-api.internal.example/api/v1
# Set → /api/v1/* is proxied there (rewrite baked in at `next build`); unset → built-in mock API.
OPERATIONS_API_URL=

# [build] Alternative: the BROWSER calls a real API directly (needs CORS on the API, and the API must
# authenticate users itself — src/proxy.ts and the console's RBAC are bypassed). Prefer OPERATIONS_API_URL.
# NEXT_PUBLIC_API_BASE=https://ops.example.com/api/v1

# ── Next.js / runtime ──────────────────────────────────────────────────────────
# [dev] build output dir, lets several `next dev` servers run side by side
# NEXT_DIST_DIR=.next-atlas
# standalone server port / bind address (the Docker image sets 8080 / 0.0.0.0 for Cloud Run)
# PORT=8080
# HOSTNAME=0.0.0.0
# Playwright base URL for `npm run test:e2e`
# PW_BASE_URL=http://localhost:3100
